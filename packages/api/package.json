{
  "name": "@town-meeting/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc/router": {
      "types": "./dist/trpc/router.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && cp -r src/templates dist/",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "db:pull": "./scripts/db-pull.sh",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/sensible": "^6.0.4",
    "@supabase/supabase-js": "^2.99.0",
    "@town-meeting/shared": "workspace:*",
    "@trpc/server": "11.18.0",
    "better-auth": "^1.7.2",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "handlebars": "^4.7.8",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "postmark": "^4.0.7",
    "puppeteer": "^24.39.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-zod": "0.8.3",
    "eslint": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
