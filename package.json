{
  "name": "town-meeting-manager",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "db:reset": "scripts/dev/reset-local-db.sh",
    "db:migrate": "./scripts/build-db-from-repo.sh \"${DATABASE_URL:?set DATABASE_URL}\"",
    "db:seed": "psql \"${DATABASE_URL:?set DATABASE_URL}\" -v ON_ERROR_STOP=1 -q -f packages/api/drizzle/seed/seed.sql"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.14",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.18"
  }
}
