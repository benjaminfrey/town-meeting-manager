# Dependencies
node_modules/

# Build output
dist/
build/

# React Router generated types
.react-router/

# Turborepo
.turbo/

# Environment variables
.env
.env.*
!.env.example
!.env.production.example

# Test coverage
coverage/

# TypeScript build info
*.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Docker — persistent data (local only)
docker/volumes/db/data/
docker/volumes/storage/
docker/.env

# Claude Code. Note this excludes the CONTENTS, not the directory itself:
# `.claude/` would stop git descending at all, and a negation cannot re-include
# a file whose parent directory was excluded.
.claude/*
# ...except workflow definitions, which are project tooling and must be tracked.
# They have to live under .claude/workflows/ to stay invocable by name.
!.claude/workflows/

# Misc
*.tgz
.cache/

# The user's own working doc — asked to stay on disk but out of git twice now
# (wave 5's fix round `git rm --cached` it; a broad `git add` in wave 6 Task 5
# re-added it, since gitignore does not retroactively apply to an add-by-name
# or `git add -A` unless the path itself is listed here). Named specifically,
# not a `docs/*.docx` glob, because `docs/town_meeting_manager_plan.docx` is a
# real tracked project doc and a glob would risk hiding a legitimate future
# addition the same way.
docs/UI-Redesign-Plan.docx

# Test artifacts
playwright-report/
test-results/
